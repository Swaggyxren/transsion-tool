{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transsion Tool",
  "version": "1.0.0",
  "identifier": "com.transsiontool.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Transsion Tool",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capability for the main window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            {
              "identifier": "http:default",
              "allow": [{ "url": "https://*" }]
            },
            "shell:default",
            "fs:default",
            "os:default",
            "notification:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/placebo.img"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "includeWebView2": true
      },
      "wix": null
    }
  }
}
